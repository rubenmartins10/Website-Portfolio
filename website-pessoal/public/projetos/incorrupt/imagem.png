<link rel="modulepreload" as="script" crossorigin="" href="https://assets-proxy.anthropic.com/claude-ai/v2/assets/v1/c6a992d55-C-21UbX1.js"><style id="ef-hover-styles">
    
  /* Claude sidebar row:
       <li>
         <div class="relative group" data-state="closed">  ← wrapper (we make this flex)
           <a ...>...</a>                                  ← anchor (flex:1)
           <div class="absolute right-0 ... group-hover:block">  ← native 3-dot
             <button>...</button>
           </div>
         </div>
       </li> */

  div.relative.group[data-state] {
    display: flex !important;
    align-items: center !important;
  }

  div.relative.group[data-state] > a[data-dd-action-name="sidebar-chat-item"] {
    flex: 1 !important;
    min-width: 0 !important;
  }

  plasmo-csui[id$="-bookmark-button"],
  plasmo-csui[id$="-add-to-folders-button"] {
    position: absolute !important;
    width: 0 !important;
    height: 0 !important;
    overflow: hidden !important;
    pointer-events: none !important;
  }

  .ef-chat-buttons {
    display: none !important;
    align-items: center !important;
    gap: 2px !important;
    flex-shrink: 0 !important;
  }

  div.relative.group:hover > .ef-chat-buttons,
  div.relative.group:focus-within > .ef-chat-buttons {
    display: flex !important;
  }

  /* Pull the absolutely-positioned 3-dot into the flex flow. */
  div.relative.group[data-state] > div.absolute.right-0 {
    position: static !important;
    transform: none !important;
    flex-shrink: 0 !important;
  }


    /* Action buttons — sized to match native 32px controls. */
    .ef-chat-btn {
      flex-shrink: 0 !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 32px !important;
      height: 32px !important;
      border: none !important;
      background: transparent !important;
      border-radius: 6px !important;
      cursor: pointer !important;
      transition: background 0.3s cubic-bezier(0.165, 0.85, 0.45, 1) !important;
    }

    .ef-chat-btn:hover {
      background: hsl(var(--bg-200)) !important;
    }

    .ef-chat-btn:active {
      transform: scale(0.95) !important;
    }
